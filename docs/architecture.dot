digraph G { graph [rankdir=TB,bgcolor="white",pad=0.2]; node [shape=box,style="rounded,filled",fillcolor="#eaf0f6",fontname="Arial",fontsize=14]; edge [fontname="Arial",fontsize=11]; app [label="App: controller + level\ncalibration, angle, states, 50 ms"]; dev [label="Devices: MPU6050\nWHO_AM_I, init, 14-byte sample"]; bus [label="Bus contract\nstart / poll / cancel"]; plat [label="Platform: STM32C0 HAL\nI2C IRQ, ADC, GPIO, UART TX"]; hw [label="Nucleo-C031C6 + MPU6050\npotentiometer + CAL + LED"]; app->dev; dev->bus; plat->bus [label="implements",style=dashed]; app->plat [label="inputs / telemetry",dir=back]; plat->hw; host [label="Host tests\nBus mock + captured bytes",fillcolor="#f5f1e4"]; host->app [style=dashed]; host->dev [style=dashed]; }